# RideLog — deny all direct web access to this directory.
# Wrapped in <IfModule> so hosts without the module do not 500.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    <IfModule mod_access_compat.c>
        Order allow,deny
        Deny from all
    </IfModule>
</IfModule>

# Belt and braces: if neither authz module is present, at least refuse to
# execute anything here.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
